# Copy this file to .env.local and fill in your key:
#   cp .env.example .env.local
#
# Get a Gemini API key at: https://aistudio.google.com/apikey
# .env.local is git-ignored, so your real key is never committed.
GEMINI_API_KEY=

# Optional — defaults to gemini-3.6-flash
# GEMINI_MODEL=gemini-3.6-flash

# Optional — override the API host (self-hosted gateway, or a local mock).
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
